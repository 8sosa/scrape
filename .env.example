# These are for LOCAL DEV ONLY (read via dotenv). On Netlify, set the same
# names as environment variables in Site settings -> Environment variables
# (or `netlify env:set NAME value`) — Netlify Functions read process.env
# directly and do not use this .env file.

# Descriptive User-Agent sent to Reddit, RemoteOK, and We Work Remotely.
SCRAPER_USER_AGENT=lead-scraper-bot/1.0 (by /u/your_username)

# Reddit OAuth "script" app credentials (required — the unauthenticated
# www.reddit.com/*.json endpoints block cloud/serverless IPs with 403).
# Get these free, no approval needed:
#   1. Log into Reddit, go to https://www.reddit.com/prefs/apps
#   2. Click "create app" / "create another app"
#   3. Name it anything, select the "script" radio button
#   4. Set "redirect uri" to http://localhost (unused for script apps, but required)
#   5. Click "create app" — REDDIT_CLIENT_ID is the string under the app name
#      (under the word "personal use script"), REDDIT_CLIENT_SECRET is the
#      value labeled "secret"
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere
TELEGRAM_CHAT_ID=-1001234567890

# Cron schedule for the standalone node-cron entrypoint (src/index.ts) only.
# The Netlify deployment ignores this — its schedule is set in
# netlify/functions/poll-leads.ts via the exported `config.schedule`.
CRON_SCHEDULE=*/10 * * * *
