# These are for LOCAL DEV ONLY (read via dotenv). On Netlify, set the same
# names as environment variables in Site settings -> Environment variables
# (or `netlify env:set NAME value`) — Netlify Functions read process.env
# directly and do not use this .env file.

# Descriptive User-Agent sent to Reddit, RemoteOK, and We Work Remotely.
SCRAPER_USER_AGENT=lead-scraper-bot/1.0 (by /u/your_username)

# Reddit OAuth "script" app credentials — OPTIONAL. Leave both unset and the
# Reddit source just sits out (logs one warning, everything else keeps
# working). As of late 2025 Reddit closed self-service API app creation —
# creating an app now routes you into a manual approval request (see the
# Responsible Builder Policy) that can take weeks or be denied. If/when you
# get approved, the client_id is the string under the app name on
# https://www.reddit.com/prefs/apps ("personal use script"), and the secret
# is the value labeled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenGoesHere
TELEGRAM_CHAT_ID=-1001234567890

# how to get a chat id
https://api.telegram.org/bot8751301355:AAGDD3QwpskE51t8sbsopLsXlqGd5OTHXVY/getupdates

# Cron schedule for the standalone node-cron entrypoint (src/index.ts) only.
# The Netlify deployment ignores this — its schedule is set in
# netlify/functions/poll-leads.ts via the exported `config.schedule`.
CRON_SCHEDULE=*/10 * * * *

# --- Auto-apply (optional) ---
# Leave any of these unset and that part of auto-apply degrades gracefully:
# no ANTHROPIC_API_KEY -> cover notes fall back to a fixed template instead
# of a Claude-drafted one; no GMAIL_* -> email-apply leads still get a
# drafted note + Approve/Skip buttons, but Approve won't actually send —
# you'd apply manually. TELEGRAM_WEBHOOK_SECRET is effectively required —
# without it the webhook function refuses every request (fails closed).

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gmail address + an App Password (NOT your regular Gmail password) —
# generate one at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification enabled on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Any long random string you generate yourself, e.g. `openssl rand -hex 32`.
# Must match the secret_token you pass when registering the Telegram webhook
# (see the setup notes for the exact setWebhook command).
TELEGRAM_WEBHOOK_SECRET=
